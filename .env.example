# Values the Kortix self-host stack reads. Copy to the machine that will run it
# and set them through `kortix self-host env set KEY=VALUE`, which restarts the
# services that read the value. Names and defaults: https://kortix.com/docs/host

# Required for sessions. Without it the stack runs and no session starts.
PLATINUM_API_KEY=

# The public URL sandboxes call back to. Must be reachable from the internet.
KORTIX_URL=https://kortix.example.com

# Set one of these before anyone outside the team can reach the instance.
# Until then any address can sign up, the admin address included.
DISABLE_SIGNUP=true
EMAIL_URL=

# Encrypts every stored secret, connector credential and token. Losing it makes
# them unreadable; keep it with the database backup, not only in git.
API_KEY_SECRET=

# Idle minutes before a session's sandbox stops. Default 15.
KORTIX_SANDBOX_AUTOSTOP_MINUTES=15
